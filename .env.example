# Database & Backend Configuration
DB_URL=postgresql://user:password@localhost:5432/database_name
PORT=5000
NODE_ENV=production

# Auth Secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=360000
REFRESH_EXPIRY=604800000
AUTH_COOKIE_SECRET=your_auth_cookie_secret_here
AUTH_SECRET=your_auth_secret_here

# Integrations & Third-Party APIs
BREVO_API_KEY=your_brevo_api_key_here

# Storage Configuration (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
# Alternatively provide direct endpoint:
# R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=codernex
R2_PUBLIC_URL=https://cdn.codernex.dev

# Fallback AWS S3 envs (if R2_* envs are not explicitly set)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key
AWS_S3_BUCKET_NAME=codernex

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GEMINI_API_KEY=your_gemini_api_key

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_S3_BASE_URL=https://cdn.codernex.dev
